# ─────────────────────────────────────────────────────────────
# Raíz Digital · Diário de bordo — variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA suba o arquivo .env para o Git (ele já está no .gitignore).
# ─────────────────────────────────────────────────────────────

# Conexão com o banco PostgreSQL (o Render fornece essa string).
# Exemplo: postgresql://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=

# Segredo usado para assinar a sessão (troque por um valor longo e aleatório).
JWT_SECRET=troque-por-um-segredo-bem-grande-e-aleatorio

# E-mail que será promovido a ADMINISTRADOR ao se cadastrar.
# Quem entrar com este e-mail enxerga as tarefas de todos.
ADMIN_EMAIL=silvio.neto@estudante.cear.ufpb.br

# (Opcional) Código de convite exigido no cadastro.
# Deixe em branco para permitir cadastro livre. Preencha para que
# só quem tiver o código consiga criar conta.
REGISTRATION_CODE=

# (Opcional) Deixe "false" para encerrar novos cadastros quando o time já entrou.
ALLOW_REGISTRATION=true

# Porta local (o Render define automaticamente em produção).
PORT=3000
